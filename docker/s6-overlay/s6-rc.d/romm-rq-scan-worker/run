#!/command/with-contenv bash

set -o errexit
set -o nounset
set -o pipefail
shopt -s inherit_errexit

ROMM_LOG_TAG="rq-scan-worker"
# shellcheck source=SCRIPTDIR/../../scripts/lib.sh
source /etc/s6-overlay/scripts/lib.sh

record_process_group

# Scans get a worker of their own, see SCAN_QUEUE_NAME.
info_log "Starting RQ scan worker"
exec_rq_worker RomMWorker scans
