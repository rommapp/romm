# Optional: copy to e2e/.env (gitignored) to override the defaults below. A
# variable set in the shell wins over this file.

# The RomM site under test: frontend and API at one origin. Unset, the suite
# runs `npm run dev` on http://localhost:3000 (or reuses the one running). Set
# it to test anything else, e.g. `npm run build && npm run preview` on 4173.
# E2E_BASE_URL=http://localhost:4173

# An admin account: every gated control must be present.
# .github/scripts/seed_e2e_users.py creates these two accounts on a dev backend.
# E2E_ADMIN_USERNAME=e2e_admin
# E2E_ADMIN_PASSWORD=e2e-Passw0rd!

# A non-admin account in the "Viewer (legacy)" group: every ROM write control
# must be absent.
# E2E_VIEWER_USERNAME=e2e_viewer
# E2E_VIEWER_PASSWORD=e2e-Passw0rd!

# Parallel workers (default 2).
# E2E_WORKERS=2
