# Optional: copy to e2e/.env to override the defaults below. The shell wins
# over this file.

# The site under test, as an origin with no path. Unset, the suite serves this
# checkout on http://127.0.0.1:3000 (or reuses the server already there).
# E2E_BASE_URL=http://127.0.0.1:4173

# An admin, and a non-admin in the "Viewer (legacy)" group. The defaults are
# the accounts .github/scripts/seed_e2e_users.py creates. E2E_PASSWORD is the
# password it seeds both with, and the fallback for the two below.
# E2E_PASSWORD=e2e-Passw0rd!
# E2E_ADMIN_USERNAME=e2e_admin
# E2E_ADMIN_PASSWORD=e2e-Passw0rd!
# E2E_VIEWER_USERNAME=e2e_viewer
# E2E_VIEWER_PASSWORD=e2e-Passw0rd!
