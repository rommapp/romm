# Browser support baseline for the RomM frontend, and the single source of
# truth for it: vite.config.js derives `build.target` and `build.cssTarget`
# from this file, so the build down-levels JS and prefixes CSS for exactly
# these browsers. Floors match Tailwind v4's minimum targets, except Chromium,
# which is 117 for CSS subgrid. Version data comes from caniuse-lite. The
# mobile engines change no output (they share an engine with a desktop entry)
# but keep coverage numbers honest.
chrome >= 117
edge >= 117
firefox >= 128
safari >= 16.4
ios_saf >= 16.4
and_chr >= 117
samsung >= 24
