{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "e2e/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    ".storybook/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "src/v2/types/fallthrough-attrs.d.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["dom", "dom.iterable", "esnext"],
    "noImplicitAny": true,
    "paths": {
      "@/*": ["./src/*"],
      "@v2/*": ["./src/v2/*"]
    },
    "types": ["node", "./src/plugins/pinia.d.ts", "vite/client"]
  }
}
