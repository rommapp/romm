{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "eslint-plugin-romm/**/*.js",
    "eslint-plugin-romm/**/*.ts"
  ]
}
